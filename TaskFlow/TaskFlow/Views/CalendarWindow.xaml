<Window x:Class="TaskFlow.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Календарь — TaskFlow"
        Height="750"
        Width="950"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Календарь"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,20"/>

        <!-- Переключение месяцев -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Предыдущий месяц -->
            <Button Grid.Column="0"
            Content="◀"
            Width="40"
            Height="35"
            FontSize="16"
            Background="White"
            Foreground="#334155"
            BorderBrush="#E2E8F0"
            Cursor="Hand"
            Click="PreviousMonth_Click"/>

            <!-- Название месяца -->
            <TextBlock x:Name="MonthTitle"
               Grid.Column="1"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="#1E293B"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

            <!-- Возврат к сегодняшней дате -->
            <Button Grid.Column="2"
            Content="Сегодня"
            Height="35"
            Padding="15,0"
            Margin="5,0"
            FontSize="13"
            FontWeight="SemiBold"
            Background="#EEF2FF"
            Foreground="#4F46E5"
            BorderBrush="#C7D2FE"
            Cursor="Hand"
            Click="Today_Click"/>

            <!-- Следующий месяц -->
            <Button Grid.Column="3"
            Content="▶"
            Width="40"
            Height="35"
            FontSize="16"
            Background="White"
            Foreground="#334155"
            BorderBrush="#E2E8F0"
            Cursor="Hand"
            Click="NextMonth_Click"/>

        </Grid>


        <!-- Дни недели -->
        <UniformGrid Grid.Row="2"
                     Columns="7"
                     Margin="0,0,0,8">

            <TextBlock Text="Пн" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Вт" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Ср" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Чт" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Пт" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Сб" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>
            <TextBlock Text="Вс" HorizontalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#64748B"/>

        </UniformGrid>

        <!-- Сетка календаря -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="5">

            <UniformGrid x:Name="CalendarGrid"
                         Columns="7"
                         Rows="6"/>

        </Border>

        <!-- Заголовок списка задач -->
        <TextBlock x:Name="SelectedDateText"
                   Grid.Row="4"
                   Text="Задачи на выбранную дату"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#1E293B"
                   Margin="0,15,0,10"/>

        <!-- Список задач выбранного дня -->
        <Border Grid.Row="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <ListBox ItemsSource="{Binding SelectedTasks}"
                     BorderThickness="0"
                     Background="Transparent">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="8"
                                Margin="0,2"
                                Background="#F8FAFC"
                                CornerRadius="6">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Отметка выполнения -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Cursor="Hand"/>

                                <!-- Название задачи -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           Foreground="#334155"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground"
                                                    Value="#334155"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                             Value="True">

                                                    <Setter Property="Foreground"
                                                            Value="#94A3B8"/>

                                                    <Setter Property="TextDecorations"
                                                            Value="Strikethrough"/>

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                                <!-- Приоритет -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Priority}"
                                           FontSize="12"
                                           Foreground="#6366F1"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

    </Grid>

</Window>
