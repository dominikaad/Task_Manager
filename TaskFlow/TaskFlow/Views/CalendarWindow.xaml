<Window x:Class="TaskFlow.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Календарь — TaskFlow"
        Height="750"
        Width="950"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Календарь"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,20"/>

        <!-- Переключение периодов -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Предыдущий период -->
            <Button Grid.Column="0"
                    Content="◀"
                    Width="40"
                    Height="35"
                    FontSize="16"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#E2E8F0"
                    Cursor="Hand"
                    Click="PreviousMonth_Click"/>

            <!-- Название периода -->
            <TextBlock x:Name="MonthTitle"
                       Grid.Column="1"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Сегодня -->
            <Button Grid.Column="2"
                    Content="Сегодня"
                    Height="35"
                    Padding="15,0"
                    Margin="5,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#EEF2FF"
                    Foreground="#4F46E5"
                    BorderBrush="#C7D2FE"
                    Cursor="Hand"
                    Click="Today_Click"/>

            <!-- Следующий период -->
            <Button Grid.Column="3"
                    Content="▶"
                    Width="40"
                    Height="35"
                    FontSize="16"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#E2E8F0"
                    Cursor="Hand"
                    Click="NextMonth_Click"/>

        </Grid>

        <!-- Переключение режимов календаря -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">

            <Button x:Name="MonthModeButton"
                    Content="Месяц"
                    Width="100"
                    Height="34"
                    Margin="4"
                    Background="#4F46E5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="MonthMode_Click"/>

            <Button x:Name="WeekModeButton"
                    Content="Неделя"
                    Width="100"
                    Height="34"
                    Margin="4"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#E2E8F0"
                    Cursor="Hand"
                    Click="WeekMode_Click"/>

            <Button x:Name="DayModeButton"
                    Content="День"
                    Width="100"
                    Height="34"
                    Margin="4"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#E2E8F0"
                    Cursor="Hand"
                    Click="DayMode_Click"/>

        </StackPanel>

        <!-- Названия дней недели -->
        <UniformGrid x:Name="WeekdayHeader"
                     Grid.Row="3"
                     Columns="7"
                     Margin="0,0,0,8">

            <TextBlock Text="Пн"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Вт"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Ср"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Чт"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Пт"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Сб"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

            <TextBlock Text="Вс"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#64748B"/>

        </UniformGrid>

        <!-- Сетка календаря -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="5">

            <UniformGrid x:Name="CalendarGrid"
                         Columns="7"
                         Rows="6"/>

        </Border>


        <!-- Заголовок списка и фильтр задач -->
        <Grid Grid.Row="5"
              Margin="0,15,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectedDateText"
               Grid.Column="0"
               Text="Задачи на выбранную дату"
               FontSize="17"
               FontWeight="SemiBold"
               Foreground="#1E293B"
               VerticalAlignment="Center"/>

            <CheckBox x:Name="ShowCompletedCheckBox"
              Grid.Column="1"
              Content="Показывать выполненные"
              IsChecked="True"
              VerticalAlignment="Center"
              Foreground="#64748B"
              FontSize="12"
              Cursor="Hand"
              Click="CompletedFilter_Click"/>

        </Grid>


        <!-- Задачи выбранного дня -->
        <Border Grid.Row="6"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <ListBox ItemsSource="{Binding SelectedTasks}"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="SelectedTasksList_MouseDoubleClick">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="8"
                                Margin="0,2"
                                Background="#F8FAFC"
                                CornerRadius="6">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Отметка выполнения -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Cursor="Hand"/>

                                <!-- Название задачи -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           Foreground="#334155"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground"
                                                    Value="#334155"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                             Value="True">

                                                    <Setter Property="Foreground"
                                                            Value="#94A3B8"/>

                                                    <Setter Property="TextDecorations"
                                                            Value="Strikethrough"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                                <!-- Приоритет задачи -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Priority}"
                                           FontSize="12"
                                           Foreground="#6366F1"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

    </Grid>

</Window>
