<Window x:Class="TaskFlow.Views.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи"
        Height="430"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F5F9">

    <Border Padding="30">
        <StackPanel>

            <TextBlock Text="Редактирование задачи"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#202B3C"
                       Margin="0,0,0,25"/>

            <!-- Название -->
            <TextBlock Text="Название задачи"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="TitleInput"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,20"/>

            <!-- Приоритет -->
            <TextBlock Text="Приоритет"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <ComboBox x:Name="PriorityInput"
                      Height="40"
                      FontSize="14"
                      SelectedIndex="1"
                      Margin="0,0,0,20">

                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>
                <ComboBoxItem Content="Критический"/>

            </ComboBox>

            <!-- Срок выполнения -->
            <TextBlock Text="Срок выполнения"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <DatePicker x:Name="DeadlineInput"
                        Height="40"
                        FontSize="14"
                        SelectedDateFormat="Short"
                        Margin="0,0,0,25"/>

            <!-- Кнопки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Сохранить"
                        Height="42"
                        Margin="0,0,7,0"
                        Background="#536FE8"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="Save_Click"/>

                <Button Grid.Column="1"
                        Content="Отмена"
                        Height="42"
                        Margin="7,0,0,0"
                        Background="#E3E7EF"
                        Foreground="#202B3C"
                        FontSize="14"
                        BorderThickness="0"
                        Click="Cancel_Click"/>

            </Grid>

        </StackPanel>
    </Border>
</Window>
