<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFlow"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Window.Resources>

        <!-- Основной стиль кнопок -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль дополнительных кнопок -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0"
                Background="#1E293B">

            <StackPanel Margin="20">

                <TextBlock Text="TaskFlow"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="Bold"
                           Margin="0,15,0,40"/>

                <TextBlock Text="МЕНЮ"
                           Foreground="#94A3B8"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Border Background="#334155"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8">

                    <TextBlock Text="Мои задачи"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                </Border>

                <Button Content="Календарь"
                        Foreground="#CBD5E1"
                        Background="Transparent"
                        FontSize="15"
                        HorizontalContentAlignment="Left"
                        Padding="12"
                        Margin="0,5"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OpenCalendar_Click"/>

                <TextBlock Text="События"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           Margin="12,12"/>

                <TextBlock Text="Статистика"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           Margin="12,12"/>

                <TextBlock Text="Настройки"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           Margin="12,12"/>

                <TextBlock Text=" "
                           VerticalAlignment="Stretch"/>

                <TextBlock Text="Версия 1.0"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="0,30,0,5"/>

            </StackPanel>
        </Border>

        <!-- ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="35,25,35,35">

                <!-- ЗАГОЛОВОК -->
                <TextBlock Text="Мои задачи"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Управляйте своими задачами и следите за сроками"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,7,0,25"/>

                <!-- СТАТИСТИКА -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,25">

                    <Border Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,12,0">

                        <StackPanel>
                            <TextBlock Text="Всего задач"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="TotalTasksText"
                                       Text="0"
                                       Foreground="#1E293B"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="6,0">

                        <StackPanel>
                            <TextBlock Text="Активные"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="ActiveTasksText"
                                       Text="0"
                                       Foreground="#D97706"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="12,0,0,0">

                        <StackPanel>
                            <TextBlock Text="Выполнено"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="CompletedTasksText"
                                       Text="0"
                                       Foreground="#16A34A"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="12,0,0,0">

                        <StackPanel>
                            <TextBlock Text="Просрочено"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="OverdueTasksText"
                                       Text="0"
                                       Foreground="#EF4444"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ДОБАВЛЕНИЕ ЗАДАЧИ -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="Добавить новую задачу"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Название задачи"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="TaskTitleInput"
                                         Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Приоритет"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="TaskPriorityInput"
                                          SelectedIndex="1">

                                    <ComboBoxItem Content="Низкий"/>
                                    <ComboBoxItem Content="Средний"/>
                                    <ComboBoxItem Content="Высокий"/>
                                    <ComboBoxItem Content="Критический"/>

                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Срок выполнения"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,6"/>

                                <DatePicker x:Name="TaskDeadlineInput"
                                            Height="38"
                                            FontSize="13"/>
                            </StackPanel>

                        </Grid>

                        <Button Content="Добавить задачу"
                                Style="{StaticResource MainButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Click="AddTask_Click"/>

                    </StackPanel>
                </Border>

                <!-- ПОИСК И ФИЛЬТРАЦИЯ -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Поиск и фильтрация"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,15"/>

                        <TextBox x:Name="SearchInput"
                                 Height="38"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 ToolTip="Введите название задачи"
                                 TextChanged="SearchInput_TextChanged"/>

                        <WrapPanel>

                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Приоритет"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="PriorityFilter"
                                          Width="175"
                                          SelectedIndex="0"
                                          SelectionChanged="Filter_SelectionChanged">

                                    <ComboBoxItem Content="Все приоритеты"/>
                                    <ComboBoxItem Content="Низкий"/>
                                    <ComboBoxItem Content="Средний"/>
                                    <ComboBoxItem Content="Высокий"/>
                                    <ComboBoxItem Content="Критический"/>

                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Статус"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="StatusFilter"
                                          Width="155"
                                          SelectedIndex="0"
                                          SelectionChanged="Filter_SelectionChanged">

                                    <ComboBoxItem Content="Все задачи"/>
                                    <ComboBoxItem Content="Активные"/>
                                    <ComboBoxItem Content="Выполненные"/>

                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Сортировка"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="SortFilter"
                                          Width="220"
                                          SelectedIndex="0"
                                          SelectionChanged="Filter_SelectionChanged">

                                    <ComboBoxItem Content="Без сортировки"/>
                                    <ComboBoxItem Content="Сначала ближайший срок"/>
                                    <ComboBoxItem Content="Сначала высокий приоритет"/>

                                </ComboBox>
                            </StackPanel>

                        </WrapPanel>

                    </StackPanel>
                </Border>

                <!-- СПИСОК ЗАДАЧ -->
                <TextBlock Text="Список задач"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,15"/>

                <ListView x:Name="TasksList"
                          ItemsSource="{Binding Tasks}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="10"
                                    Padding="15">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ВЫПОЛНЕНИЕ -->
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsCompleted,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- ИНФОРМАЦИЯ О ЗАДАЧЕ -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding Priority}"
                                                   FontSize="12"
                                                   Foreground="#6366F1"
                                                   Margin="0,3,0,0"/>

                                        <!-- СТАТУС СРОКА -->
                                        <TextBlock Text="{Binding DeadlineStatusText}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                                            Value="#64748B"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsOverdue}"
                                                                     Value="True">

                                                            <Setter Property="Foreground"
                                                                    Value="#EF4444"/>

                                                            <Setter Property="FontWeight"
                                                                    Value="Bold"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding DeadlineStatusText}"
                                                                     Value="Срок сегодня">

                                                            <Setter Property="Foreground"
                                                                    Value="#D97706"/>

                                                            <Setter Property="FontWeight"
                                                                    Value="Bold"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding IsCompleted}"
                                                                     Value="True">

                                                            <Setter Property="Foreground"
                                                                    Value="#16A34A"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </StackPanel>

                                    <!-- ИЗМЕНИТЬ -->
                                    <Button Grid.Column="2"
                                            Content="Изменить"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="EditTask_Click"/>

                                    <!-- УДАЛИТЬ -->
                                    <Button Grid.Column="3"
                                            Content="Удалить"
                                            Background="#FEE2E2"
                                            Foreground="#DC2626"
                                            FontSize="12"
                                            Padding="10,7"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="DeleteTask_Click"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
