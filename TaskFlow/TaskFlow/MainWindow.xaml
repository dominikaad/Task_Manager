<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFlow"
        Height="760"
        Width="1100"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="#202B3C">
            <StackPanel Margin="25">

                <TextBlock Text="TaskFlow"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,15,0,45"/>

                <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО"
                           FontSize="11"
                           Foreground="#91A0B5"
                           Margin="0,0,0,15"/>

                <Border Background="#34445B"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <TextBlock Text="✓   Мои задачи"
                               FontSize="15"
                               Foreground="White"/>
                </Border>

                <TextBlock Text="Календарь"
                           FontSize="15"
                           Foreground="#C4CEDB"
                           Margin="12,12"/>

                <TextBlock Text="События"
                           FontSize="15"
                           Foreground="#C4CEDB"
                           Margin="12,12"/>

                <TextBlock Text="Статистика"
                           FontSize="15"
                           Foreground="#C4CEDB"
                           Margin="12,12"/>

                <TextBlock Text="Настройки"
                           FontSize="15"
                           Foreground="#C4CEDB"
                           Margin="12,12"/>

                <TextBlock Text="Версия 0.1"
                           FontSize="12"
                           Foreground="#91A0B5"
                           Margin="0,60,0,0"/>

            </StackPanel>
        </Border>

        <!-- Основная рабочая область -->
        <Border Grid.Column="1" Padding="35">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Мои задачи"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#202B3C"/>

                    <TextBlock Text="Планируйте свои дела и следите за их выполнением"
                               FontSize="14"
                               Foreground="#788397"
                               Margin="0,8,0,30"/>

                    <!-- Статистика -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Всего задач"
                                           Foreground="#788397"
                                           FontSize="13"/>
                                <TextBlock x:Name="TotalCountText"
                                           Text="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#202B3C"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="White"
                                CornerRadius="10"
                                Padding="18"
                                Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="Активные"
                                           Foreground="#788397"
                                           FontSize="13"/>
                                <TextBlock x:Name="ActiveCountText"
                                           Text="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#D58B35"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="White"
                                CornerRadius="10"
                                Padding="18"
                                Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Выполнено"
                                           Foreground="#788397"
                                           FontSize="13"/>
                                <TextBlock x:Name="CompletedCountText"
                                           Text="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#299B72"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Добавление задачи -->
                    <TextBlock Text="Добавить новую задачу"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#202B3C"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TaskTitleInput"
                                 Grid.Column="0"
                                 Height="43"
                                 FontSize="14"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Введите название задачи"/>

                        <Button Grid.Column="1"
                                Content="+ Добавить"
                                Height="43"
                                Margin="10,0,0,0"
                                Background="#536FE8"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AddTask_Click"/>
                    </Grid>

                    <!-- Список задач -->
                    <TextBlock Text="Список задач"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#202B3C"
                               Margin="0,0,0,15"/>

                    <ListView x:Name="TasksList"
                              ItemsSource="{Binding Tasks}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="10"
                                        Padding="15">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="85"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#202B3C"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       Foreground="#788397"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Content="Удалить"
                                                Tag="{Binding}"
                                                Click="DeleteTask_Click"
                                                Background="#FCEAEA"
                                                Foreground="#C94C4C"
                                                BorderThickness="0"
                                                Padding="8,6"
                                                Cursor="Hand"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
